---
layout: base.njk
bodyClass: page-about
---
{%- set sections = content | aboutSections -%}
<nav class="recipe-nav" aria-label="Page tools">
  <a href="/{% if category %}#{{ category | slugify }}{% endif %}" class="back">← The cookbook</a>
  <span class="tools">
    <a class="tool" href="{{ site.repo }}/edit/{{ site.branch }}/{{ page.inputPath | replace('./', '') }}">Edit</a>
  </span>
</nav>
<article class="about{% if articleClass %} {{ articleClass }}{% endif %}">
  <header class="recipe-header">
    <h1 class="recipe-title">{{ title }}</h1>
    {%- if jump and sections.length > 1 %}
    <p class="about-jump"><a href="#{{ jump.to | slugify }}">{{ jump.label | typography }} ↓</a></p>
    {%- endif %}
    {%- if edition %}
    <p class="about-edition"><a href="{{ edition.url }}">{{ edition.label | typography }}</a></p>
    {%- endif %}
  </header>
  {%- for s in sections %}
  <section class="about-section" id="{{ s.heading | striptags | slugify }}">
    <h2 class="story-label">{{ s.heading | safe }}</h2>
    {{ s.body | safe }}
  </section>
  {%- else %}
  <p class="about-empty">Coming soon.</p>
  {%- endfor %}
  {#- A section foreword (category: set) lists that section's recipes after the text. -#}
  {%- if category %}
  {%- set sectionRecipes = collections.recipes | inCategory(category) %}
  {%- if sectionRecipes.length %}
  <section class="about-section foreword-recipes">
    <h2 class="story-label">The recipes</h2>
    <ol class="chapter-list">
      {%- for r in sectionRecipes %}
      {% include "toc-entry.njk" %}
      {%- endfor %}
    </ol>
  </section>
  {%- endif %}
  {%- endif %}
</article>
