{#- One recipe, used by both its own page and the printed book.
    Expects: rd (front matter), rhtml (rendered Markdown), rslug, rpath (source file), inBook. -#}
{%- set parts = rhtml | sections -%}
{%- set shown = rd.photos | availablePhotos(photoFiles) -%}
{%- set ph = shown | groupPhotos(parts.gallery | galleryPhotoNames) -%}
{%- set gallery = parts.gallery | galleryItems(ph.snaps, photoFiles) -%}
<article class="recipe{% if rd.status == 'draft' %} is-draft{% endif %}{% if ph.hero %} has-photo{% endif %}" id="r-{{ rslug }}" data-slug="{{ rslug }}">
  <header class="recipe-header">
    <p class="recipe-kicker">{% if rd.archive %}{{ site.archive.name }} · {% endif %}{{ rd.category }}{% if rd.from %} · {{ rd.from }} kitchen{% endif %}</p>
    <h1 class="recipe-title">{{ rd.title | typography }}</h1>
    {%- if rd.credit %}<p class="recipe-credit">from {{ rd.credit }}</p>{% endif %}
    {%- if rd.serves or rd.time %}
    <dl class="recipe-facts">
      {%- if rd.serves %}<div><dt>Serves</dt><dd>{{ rd.serves }}</dd></div>{% endif %}
      {%- if rd.time %}<div><dt>Time</dt><dd>{{ rd.time | typography }}</dd></div>{% endif %}
    </dl>
    {%- endif %}
    {%- if rd.status == 'draft' %}<p class="draft-note">A recipe still being written down</p>{% endif %}
  </header>

  {%- if ph.hero %}
  <figure class="recipe-hero">
    <img src="/images/{{ ph.hero | photoName }}.jpg" srcset="/images/{{ ph.hero | photoName }}-800.jpg 800w, /images/{{ ph.hero | photoName }}.jpg 1600w" sizes="(min-width: 60rem) 56rem, 100vw" alt="{{ ph.hero | photoCaption or rd.title }}">
    {%- if ph.hero | photoCaption %}<figcaption>{{ ph.hero | photoCaption }}</figcaption>{% endif %}
  </figure>
  {%- endif %}

  {%- set hasOriginal = parts.intro | trim %}
  {%- set fromBook = hasOriginal and rd.source %}
  {%- set storyCount = parts.stories.length + (1 if hasOriginal else 0) + ph.cards.length %}
  {%- if storyCount %}
  <div class="recipe-stories{% if storyCount > 1 %} has-two{% endif %}{% if storyCount > 2 %} has-more{% endif %}">
    {#- Rod and Katherine's words first (left), the original second (right). -#}
    {%- for st in parts.stories %}
    <div class="recipe-story">
      <p class="story-label">{{ st.label | safe }}</p>
      {{ st.body | safe }}
    </div>
    {%- endfor %}
    {%- if hasOriginal %}
    <div class="recipe-story{% if fromBook %} book-note{% endif %}">
      {%- if rd.story_by %}<p class="story-label">From {{ rd.story_by }}</p>{% endif %}
      {{ parts.intro | safe }}
      {%- if fromBook %}<p class="book-note-source">{{ rd.source | typography | linkUrls | safe }}</p>{% endif %}
    </div>
    {%- endif %}
    {#- The original recipe card(s), pinned beside the descriptions, never cropped. -#}
    {%- for c in ph.cards %}
    <figure class="recipe-card-photo">
      <a href="/images/{{ c | photoName }}.jpg" class="zoom"><img src="/images/{{ c | photoName }}-800.jpg" alt="{{ c | photoCaption }} for {{ rd.title }}"></a>
      <figcaption>{{ c | photoCaption }}<span class="zoom-hint screen-only"> · tap to read</span></figcaption>
    </figure>
    {%- endfor %}
  </div>
  {%- endif %}

  <div class="recipe-body">
    {%- if parts.ingredients %}
    <section class="recipe-ingredients" aria-labelledby="{{ rslug }}-ingredients">
      <h2 id="{{ rslug }}-ingredients">{{ parts.ingredientsLabel | safe }}</h2>
      {{ parts.ingredients | safe }}
    </section>
    {%- endif %}
    {%- if parts.method %}
    <section class="recipe-method" aria-labelledby="{{ rslug }}-method">
      <h2 id="{{ rslug }}-method">{{ parts.methodLabel | safe }}</h2>
      {{ parts.method | withStepPhotos(ph.steps, rd.title) | safe }}
    </section>
    {%- endif %}
  </div>

  {%- for o in parts.other %}
  <section class="recipe-extra"><h2>{{ o.heading | safe }}</h2>{{ o.body | safe }}</section>
  {%- endfor %}

  {%- if parts.notes %}
  <section class="recipe-notes" aria-labelledby="{{ rslug }}-notes">
    <h2 id="{{ rslug }}-notes">Notes</h2>
    {{ parts.notes | safe }}
  </section>
  {%- endif %}

  {#- The Gallery: sentimental and contextual photos and words, after the Notes. -#}
  {%- if gallery.length %}
  <section class="recipe-gallery-section" aria-labelledby="{{ rslug }}-gallery">
    <h2 id="{{ rslug }}-gallery">Gallery</h2>
    <div class="recipe-gallery">
      {%- for g in gallery %}
      {%- if g.photo %}
      <figure class="gallery-photo">
        <a href="/images/{{ g.photo }}.jpg" class="zoom"><img src="/images/{{ g.photo }}-800.jpg" loading="lazy" alt="{{ g.alt or g.caption or rd.title }}"></a>
        {%- if g.caption or g.text %}<figcaption>{% if g.caption %}<span class="gallery-caption">{{ g.caption }}</span>{% endif %}{{ g.text | safe }}</figcaption>{% endif %}
      </figure>
      {%- else %}
      <div class="gallery-note">{{ g.text | safe }}</div>
      {%- endif %}
      {%- endfor %}
    </div>
  </section>
  {%- endif %}

  {%- if rd.source and not fromBook %}<p class="recipe-source">{{ rd.source | typography | linkUrls | safe }}</p>{% endif %}
</article>
