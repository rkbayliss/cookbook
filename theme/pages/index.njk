---
layout: base.njk
permalink: /
bodyClass: page-index
---
{%- set all = collections.recipes -%}
<section class="title-page">
  <p class="title-families">{{ site.families }}</p>
  <h1 class="title-main">{{ site.title }}</h1>
  <p class="title-tagline">{{ site.tagline }}</p>
  <p class="title-count">{{ all.length }} recipes</p>
</section>

<section class="finder" aria-label="Find a recipe">
  <label class="search">
    <span class="visually-hidden">Search recipes</span>
    <input type="search" id="search" placeholder="Search by name, cook, or ingredient…" autocomplete="off">
  </label>
  <div class="filters" role="group" aria-label="Kitchen">
    <button type="button" class="chip is-on" data-family="">Both kitchens</button>
    {%- for f in all | families %}
    <button type="button" class="chip" data-family="{{ f | lower }}">{{ f }}</button>
    {%- endfor %}
  </div>
  <div class="filters" role="group" aria-label="Occasion">
    {%- for t in all | allTags %}
    <button type="button" class="chip chip-tag" data-tag="{{ t }}">{{ t }}</button>
    {%- endfor %}
  </div>
  <p class="finder-status" id="finder-status" aria-live="polite"></p>
</section>

<nav class="contents" aria-label="Contents">
  {%- for group in all | byCategory %}
  <section class="chapter" id="{{ group.slug }}">
    <h2 class="chapter-title"><span class="chapter-number">{{ loop.index0 | roman }}</span> {{ group.name }}</h2>
    <ol class="chapter-list">
      {%- for r in group.items %}
      <li class="entry" data-family="{{ (r.data.from or '') | lower }}" data-tags="{{ (r.data.tags or []) | join(',') }}" data-search="{{ r | searchText }}">
        <label class="entry-pick"><input type="checkbox" value="{{ r.page.fileSlug }}"><span class="visually-hidden">Select {{ r.data.title }} for printing</span></label>
        <a href="{{ r.url }}" class="entry-link">
          <span class="entry-title">{{ r.data.title | typography }}{% if r.data.status == 'draft' %} <em class="entry-draft">in progress</em>{% endif %}</span>
          <span class="entry-leader" aria-hidden="true"></span>
          <span class="entry-credit">{{ r.data.credit }}{% if r.data.from %}<span class="entry-family"> · {{ r.data.from }}</span>{% endif %}</span>
        </a>
      </li>
      {%- endfor %}
    </ol>
  </section>
  {%- endfor %}
</nav>

<section class="print-bar" aria-label="Print">
  <p>Download the cookbook as a PDF: <a href="/pdf/family-cookbook.pdf">the whole book</a> · <a href="/pdf/bayliss-kitchen.pdf">the Bayliss kitchen</a> · <a href="/pdf/paseman-kitchen.pdf">the Paseman kitchen</a></p>
  <p>
    <button type="button" class="tool" id="pick-toggle">Choose recipes to print</button>
    <a class="tool tool-strong" id="pick-print" href="/book/" hidden>Print selected</a>
  </p>
</section>
