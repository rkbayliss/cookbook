---
layout: base.njk
permalink: /
bodyClass: page-index
---
{%- set all = collections.recipes -%}
<nav class="home-nav" aria-label="Site">
  <a href="/about/">About the cookbook</a>
</nav>
{#- Frontispiece: the title facing a mounted photograph, as in an old book. -#}
<header class="frontispiece">
  <div class="frontis-text">
    <h1 class="title-main">{{ site.title }}</h1>
    <p class="title-tagline">{{ site.tagline }}</p>
    <label class="search">
      <span class="visually-hidden">Search recipes</span>
      <input type="search" id="search" placeholder="Search {{ all.length }} recipes…" title="Search by name, cook, or ingredient" autocomplete="off">
    </label>
  </div>
  <figure class="frontis-photo">
    <img src="/assets/header.jpg" srcset="/assets/header-1000.jpg 1000w, /assets/header.jpg 1800w"
         sizes="(min-width: 52rem) 26rem, 100vw" width="1800" height="1200"
         alt="Rod and Katherine on their wedding day, foreheads together, both smiling">
    <figcaption>Our Wedding Day — September 26, 2026</figcaption>
  </figure>
</header>

<section class="finder" aria-label="Filter recipes">
  <div class="filters" role="group" aria-label="Kitchen">
    <button type="button" class="chip is-on" data-family="">All kitchens</button>
    {%- for f in all | families(site.kitchens) %}
    <button type="button" class="chip" data-family="{{ f | lower }}">{{ f }}</button>
    {%- endfor %}
  </div>
  <div class="filters" role="group" aria-label="Occasion">
    {%- for t in all | allTags %}
    <button type="button" class="chip chip-tag" data-tag="{{ t }}">{{ t }}</button>
    {%- endfor %}
  </div>
  <p class="finder-status" id="finder-status" aria-live="polite"></p>
</section>

{#- Two parallel sections: The Recipe Box (everyday) and The Archive (archive: true). -#}
{%- set sections = [
  { id: "recipe-box", prefix: "", name: site.recipeBox.name, blurb: site.recipeBox.blurb, recipes: all | everyday },
  { id: "archive", prefix: "archive-", name: site.archive.name, blurb: site.archive.blurb, recipes: all | archived }
] -%}
<nav class="contents" aria-label="Contents">
  {%- for sec in sections %}{% if sec.recipes.length %}
  <section class="cookbook-section" id="{{ sec.id }}">
    <header class="section-header">
      <h2 class="section-title">{{ sec.name }}</h2>
      <p class="section-blurb">{{ sec.blurb }}</p>
    </header>
    {%- for group in sec.recipes | byCategory %}
    <section class="chapter" id="{{ sec.prefix }}{{ group.slug }}">
      <h3 class="chapter-title"><span class="chapter-number">{{ loop.index0 | roman }}</span> {{ group.name }}</h3>
      <ol class="chapter-list">
        {%- for r in group.items %}
        {% include "toc-entry.njk" %}
        {%- endfor %}
      </ol>
    </section>
    {%- endfor %}
  </section>
  {%- endif %}{% endfor %}
</nav>

<section class="print-bar" aria-label="Print">
  <p>Download the cookbook as a PDF: <a href="/pdf/family-cookbook.pdf">the whole book</a> · <a href="/pdf/rkbayliss-kitchen.pdf">the RKBayliss kitchen</a> · <a href="/pdf/bayliss-kitchen.pdf">the Bayliss kitchen</a> · <a href="/pdf/paseman-kitchen.pdf">the Paseman kitchen</a></p>
  <p>
    <button type="button" class="tool" id="pick-toggle">Choose recipes to print</button>
    <a class="tool tool-strong" id="pick-print" href="/book/" hidden>Print selected</a>
  </p>
</section>
